#include <dt-bindings/zmk/matrix_transform.h>
#include "layouts.dtsi"

/ {
    chosen {
        zmk,physical-layout = &physical_layout0;
        zmk,kscan = &kscan0;
zmk,battery = &non_lipo_battery;
    };

    default_transform: keymap_transform_0 {
        compatible = "zmk,matrix-transform";
        columns = <5>;
        rows = <5>;
        map = <
            RC(0,0) RC(0,1) RC(0,2) RC(0,3) RC(0,4)
            RC(1,0) RC(1,1) RC(1,2) RC(1,3) RC(1,4)
            RC(2,0) RC(2,1) RC(2,2) RC(2,3) RC(2,4)
            RC(3,0) RC(3,1) RC(3,2) RC(3,3) RC(3,4)
            RC(4,0) RC(4,1) RC(4,2) RC(4,3) RC(4,4)
        >;
    };

  kscan0: kscan {
        compatible = "zmk,kscan-gpio-matrix";

        col-gpios =
            <&gpio0 30 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>,
            <&gpio0 3 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>,
            <&gpio1 14 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>,
            <&gpio0 20 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>,
            <&gpio1 15 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>;

        row-gpios =
            <&gpio0 8 (GPIO_ACTIVE_LOW)>,
            <&gpio1 3 (GPIO_ACTIVE_LOW)>,
            <&gpio1 0 (GPIO_ACTIVE_LOW)>,
            <&gpio0 16 (GPIO_ACTIVE_LOW)>,
            <&gpio0 19 (GPIO_ACTIVE_LOW)>;
       wakeup-source;
    };

    encoder1: encoder1 {
        compatible = "alps,ec11";
        a-gpios = <&gpio0 22 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>;
        b-gpios = <&gpio0 23 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>;

        steps = <24>;
        status = "okay";
    };

    encoder2: encoder2 {
        compatible = "alps,ec11";
        a-gpios = <&gpio0 18 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>;
        b-gpios = <&gpio0 11 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>;

        steps = <24>;
        status = "okay";
    };
    encoder3: encoder3 {
        compatible = "alps,ec11";
        a-gpios = <&gpio0 0 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>;
        b-gpios = <&gpio0 5 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>;
        steps = <24>;
        status = "okay";
    };


    sensors: sensors {
        compatible = "zmk,keymap-sensors";
        sensors = <&encoder1>, <&encoder2>, <&encoder3>;
        triggers-per-rotation = <6>;
    };

    non_lipo_battery: non_lipo_battery {
        compatible = "zmk,non-lipo-battery";
        io-channels = <&adc 7>;
    };
};



&physical_layout0 {
    kscan = <&kscan0>;
    transform = <&default_transform>;
};
